# Create a local .env file from this template. Do not commit it.
TELEGRAM_BOT_TOKEN=

# RЕА Plekhanov. Leave both values empty to run the bot without RЕА checks.
REA_JWT=
REA_PROFILE=

# Optional: a comma-separated list of Telegram chat IDs allowed to use the bot.
# ALLOWED_CHAT_IDS=123456789

# Optional paths for local state. Defaults are storage.json and subscribers.json.
# STORAGE_PATH=storage.json
# SUBSCRIBERS_PATH=subscribers.json

# Six hours in seconds.
CHECK_INTERVAL=21600
